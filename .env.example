# Canonical site URL — used for metadataBase, Open Graph, canonical, sitemap & robots.
# Falls back to https://muhammadadnan-ai.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://muhammadadnan-ai.vercel.app

# Contact form — direct-to-inbox delivery (optional).
# Without this, the form falls back to opening the visitor's email client (mailto).
# Get a free access key at https://web3forms.com, then copy this file to .env.local:
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
